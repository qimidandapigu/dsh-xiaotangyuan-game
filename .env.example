# Chat/vision key. Never commit a real key.
AI_API_KEY=

# OpenAI-compatible endpoint configuration.
AI_BASE_URL=https://api.openai.com/v1
CHAT_URL=
TRANSCRIPTION_URL=
TTS_URL=

# Choose models supported by your provider.
CHAT_MODEL=gpt-4o-mini
TRANSCRIPTION_MODEL=whisper-1
TTS_MODEL=tts-1
TTS_VOICE=alloy

# Voice backend. Use "volcengine" to mirror the StardewAIChat setup.
VOICE_PROVIDER=openai
VOLCENGINE_API_KEY=
VOLCENGINE_ASR_RESOURCE_ID=volc.bigasr.auc
VOLCENGINE_TTS_RESOURCE_ID=seed-tts-1.0

# Interaction and capture.
VOICE_KEY=v
GAME_WINDOW_TITLE=Don't Starve Together
SCREENSHOT_MAX_WIDTH=512
VISION_THINKING=false
REQUEST_TIMEOUT_SECONDS=30

# Optional overrides. Automatic Steam discovery is used when blank.
DST_GAME_DIR=
DST_STATE_FILE=
DST_REPLY_FILE=
DST_REQUEST_FILE=

# Reply language: Chinese, English, or another language name.
REPLY_LANGUAGE=Chinese
