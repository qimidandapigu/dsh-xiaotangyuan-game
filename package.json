{
  "name": "dsh-xiaotangyuan-game-workspace",
  "private": true,
  "version": "0.4.1",
  "description": "XiaoTangYuan Game AI monorepo.",
  "scripts": {
    "build": "pnpm --filter @qimidandapigu/dsh-xiaotangyuan-game build",
    "test": "pnpm --filter @qimidandapigu/dsh-xiaotangyuan-game test",
    "check": "pnpm --filter @qimidandapigu/dsh-xiaotangyuan-game check",
    "pack:plugin": "pnpm --filter @qimidandapigu/dsh-xiaotangyuan-game pack",
    "build:stardew": "dotnet build games/stardew-valley/adapter/StardewAgentMod.csproj -c Release",
    "build:media": "dotnet publish apps/windows-media-host/XtyMediaHost.csproj -c Release -r win-x64 --self-contained true -o apps/harness-plugin/media/windows-x64"
  }
}
